# ============================================
# TruXpert Backend - Environment Variables
# ============================================
# For Render/Production: Set these in the Render dashboard
# For Local Development: Set these as system environment variables
#   - Windows: setx VARIABLE_NAME "value" (or use System Properties)
#   - Mac/Linux: export VARIABLE_NAME=value (add to ~/.bashrc or ~/.zshrc)
#
# Alternatively, you can pass them when running Maven:
#   mvn spring-boot:run -Dspring-boot.run.arguments="--DATABASE_PASSWORD=yourpass"

# Database Configuration (MySQL)
DATABASE_URL=jdbc:mysql://localhost:3306/foodtruck?createDatabaseIfNotExist=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_database_password

# Server Port (Render sets this automatically)
PORT=8080

# JPA Configuration
DDL_AUTO=update
SHOW_SQL=false

# Security - Seed Password for Data Seeder
# Change this to a strong password in production!
SEED_PASSWORD=YourSecureSeedPassword123!

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:3000
